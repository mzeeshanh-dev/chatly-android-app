# Copy to .env (gitignored) and fill in real values.
# Run `npm run setup:firebase` afterwards to regenerate android/app/google-services.json
# from this — never commit the real file.

# Base64 of the real google-services.json downloaded from
# Firebase Console -> Project Settings -> Your apps -> com.chatly.mobile (Android).
# Generate with: certutil -encode android\app\google-services.json tmp.b64 (Windows)
#            or: base64 -w0 android/app/google-services.json (Linux/macOS)
GOOGLE_SERVICES_JSON_BASE64=
