rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function isGroupMemberDoc(groupData) {
      return signedIn()
        && 'memberIds' in groupData
        && request.auth.uid in groupData.memberIds;
    }

    function isGroupAdminDoc(groupData) {
      return signedIn() && groupData.adminId == request.auth.uid;
    }

    function isGroupMemberParent(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function deletedForSelfOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
        && request.resource.data.deletedFor is list
        && request.auth.uid in request.resource.data.deletedFor
        && (
          !('deletedFor' in resource.data)
            ? request.resource.data.deletedFor.hasOnly([request.auth.uid])
            : request.resource.data.deletedFor.hasAll(resource.data.deletedFor)
              && request.resource.data.deletedFor.size() <= resource.data.deletedFor.size() + 1
        );
    }

    function messageEditBySenderWithinWindow() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text',
          'edited',
          'editedAt'
        ])
        && resource.data.senderId == request.auth.uid
        && resource.data.type == "text"
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.edited == true
        && request.resource.data.editedAt == request.time
        && request.time <= resource.data.timestamp + duration.value(3, "m");
    }

    match /users/{uid} {
      allow read: if signedIn() && (resource == null || resource.data.isActivated == true);
      allow create: if true;
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'email',
          'createdAt'
        ]);
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ["text", "system"];
        allow update: if isChatParticipant(chatId)
          && (
            deletedForSelfOnly()
            || messageEditBySenderWithinWindow()
          );
        allow delete: if isChatParticipant(chatId)
          && resource.data.senderId == request.auth.uid;
      }

      // ADDED: Rules for new Chat-level subcollections
      match /questions/{questionId} {
        allow read, write: if isChatParticipant(chatId);
      }
      match /decisions/{decisionId} {
        allow read, write: if isChatParticipant(chatId);
      }
      match /tasks/{taskId} {
        allow read, write: if isChatParticipant(chatId);
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn() && (resource == null || isGroupMemberDoc(resource.data));
      allow create: if signedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update: if isGroupAdminDoc(resource.data)
        || isGroupMemberDoc(resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isGroupMemberParent(groupId);
        allow create: if isGroupMemberParent(groupId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ["text", "system"];
        allow update: if isGroupMemberParent(groupId)
          && (
            deletedForSelfOnly()
            || messageEditBySenderWithinWindow()
          );
        allow delete: if isGroupMemberParent(groupId)
          && resource.data.senderId == request.auth.uid;
      }

      // ADDED: Rules for new Group-level subcollections
      match /questions/{questionId} {
        allow read, write: if isGroupMemberParent(groupId);
      }
      match /decisions/{decisionId} {
        allow read, write: if isGroupMemberParent(groupId);
      }
      match /tasks/{taskId} {
        allow read, write: if isGroupMemberParent(groupId);
      }
    }

    match /otps/{otpId} {
      allow read, write: if true;
    }

    // ADDED: Rules for the new top-level Follow-ups collection
    match /followUps/{followUpId} {
      allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
  }
}
