# Non-secret Cloud Functions config, loaded automatically by firebase-functions v2.
# Copy to .env and fill in — same values as the Chatly web app's .env.
# The two actually-sensitive values (SMTP_PASS, CLOUDINARY_API_SECRET) are NOT
# here — they're set via `firebase functions:secrets:set` (Secret Manager),
# never committed and never present in plaintext on disk.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=

APP_NAME=Chatly
APP_URL=https://chatly-stream.vercel.app/chat
